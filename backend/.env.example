PORT=3000

# =============================================================================
# SafeSpeak Emergency SMS Gateway Configuration
# To send REAL carrier SMS to the registered emergency contact, fill in your credentials below.
# =============================================================================

# OPTION 1: Twilio (Recommended for Global SMS)
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION 2: Fast2SMS (Alternative for India SMS)
# Get API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=
