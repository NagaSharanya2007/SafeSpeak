PORT=3000

# =============================================================================
# SafeSpeak AI Configuration (Empathy Copilot & Multilingual Analysis)
# =============================================================================
GOOGLE_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# SafeSpeak Emergency Alert Gateway Configuration
# =============================================================================

# OPTION 1: Email Alerts (Gmail / SMTP / Brevo / SendGrid)
# If using Gmail, generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafeSpeak Emergency Alert" <alert@safespeak.org>

# OPTION 2: Twilio SMS (Global SMS)
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION 3: Fast2SMS (India SMS Gateway)
# Get API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=
